# ==============================================================================
# Environment & Secrets (Security Invariant: NEVER COMMIT SECRETS)
# ==============================================================================
.env
.env*
!.env.example
!.env.test.example

# Local credentials, certificates & private keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json

# ==============================================================================
# Next.js Build Outputs & Artifacts
# ==============================================================================
.next/
out/
build/
dist/
next-env.d.ts

# Vercel Deployment Metadata
.vercel/

# ==============================================================================
# Testing, Coverage & Quality Reports
# ==============================================================================
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/
.vitest-cache/

# Code Quality & Health Tool Reports
react-doctor-report.json
react-doctor-*.json
.react-doctor/

# ==============================================================================
# TypeScript & Linter Caches
# ==============================================================================
*.tsbuildinfo
tsconfig.tsbuildinfo
.eslintcache

# ==============================================================================
# Debugging & Application Logs
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

