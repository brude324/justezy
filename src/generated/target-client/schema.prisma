model AssetCategory {
  id                   String                  @id @default(cuid())
  tenantId             String
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  code                 String
  description          String?                 @db.Text
  usefulLifeMonths     Int                     @default(60)
  residualValuePercent Decimal                 @default(5.00) @db.Decimal(5, 2)
  depreciationMethod   AssetDepreciationMethod @default(STRAIGHT_LINE)
  active               Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  assets Asset[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model Asset {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetTag         String
  serialNumber     String?
  name             String
  description      String?          @db.Text
  categoryId       String
  category         AssetCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId         String?
  vendor           InventoryVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  location         String?
  condition        AssetCondition   @default(GOOD)
  status           AssetStatus      @default(ACTIVE)
  acquisitionDate  DateTime         @default(now())
  acquisitionCost  Decimal          @db.Decimal(12, 2)
  usefulLifeMonths Int              @default(60)
  residualValue    Decimal          @default(0) @db.Decimal(12, 2)
  bookValue        Decimal          @db.Decimal(12, 2)
  warrantyExpiry   DateTime?
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  components    AssetComponent[]
  assignments   AssetAssignment[]
  transfers     AssetTransfer[]
  returns       AssetReturn[]
  maintenances  AssetMaintenance[]
  disposals     AssetDisposal[]
  depreciations AssetDepreciation[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, serialNumber])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
}

model AssetComponent {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentAssetId String
  parentAsset   Asset    @relation(fields: [parentAssetId], references: [id], onDelete: Cascade)
  assetTag      String?
  name          String
  serialNumber  String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([parentAssetId])
  @@index([tenantId])
}

model AssetAssignment {
  id                 String                @id @default(cuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId            String
  asset              Asset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedToType     String
  assignedToId       String
  assignedDate       DateTime              @default(now())
  expectedReturnDate DateTime?
  conditionOnAssign  AssetCondition        @default(GOOD)
  returnDate         DateTime?
  conditionOnReturn  AssetCondition?
  status             AssetAssignmentStatus @default(ACTIVE)
  notes              String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  returns AssetReturn[]

  @@index([assetId])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
}

model AssetTransfer {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId              String
  asset                Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fromLocation         String?
  toLocation           String?
  fromAssigneeId       String?
  toAssigneeId         String?
  transferDate         DateTime @default(now())
  reason               String?  @db.Text
  actorUserId          String?
  acknowledgedByUserId String?
  notes                String?  @db.Text
  createdAt            DateTime @default(now())

  @@index([assetId])
  @@index([tenantId, transferDate])
}

model AssetReturn {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId     String
  assignment       AssetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  returnDate       DateTime        @default(now())
  condition        AssetCondition
  notes            String?         @db.Text
  returnedByUserId String?
  createdAt        DateTime        @default(now())

  @@index([assignmentId])
  @@index([tenantId, assetId])
}

model AssetMaintenance {
  id                String                 @id @default(cuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  maintenanceType   AssetMaintenanceType   @default(PREVENTIVE)
  status            AssetMaintenanceStatus @default(REQUESTED)
  requestedDate     DateTime               @default(now())
  scheduledDate     DateTime?
  completedDate     DateTime?
  vendorName        String?
  cost              Decimal                @default(0) @db.Decimal(12, 2)
  notes             String?                @db.Text
  nextScheduledDate DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([assetId])
  @@index([tenantId, status])
}

model AssetDisposal {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  disposalType     AssetDisposalType   @default(SCRAP)
  status           AssetDisposalStatus @default(REQUESTED)
  disposalDate     DateTime?
  reason           String              @db.Text
  approvedByUserId String?
  approvedAt       DateTime?
  proceedsAmount   Decimal             @default(0) @db.Decimal(12, 2)
  buyerName        String?
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([assetId])
  @@index([tenantId, status])
}

model AssetDepreciation {
  id                      String   @id @default(cuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId                 String
  asset                   Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalYear              String
  periodNumber            Int
  depreciationAmount      Decimal  @db.Decimal(12, 2)
  accumulatedDepreciation Decimal  @db.Decimal(12, 2)
  endingBookValue         Decimal  @db.Decimal(12, 2)
  calculationDate         DateTime @default(now())
  createdAt               DateTime @default(now())

  @@unique([tenantId, assetId, fiscalYear, periodNumber])
  @@index([assetId])
}

// ============================================================================
// PLANE 19: HUMAN RESOURCES (V2 WAVE 5)
