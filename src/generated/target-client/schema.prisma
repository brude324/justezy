enum HREmploymentStatus {
  ACTIVE
  PROBATION
  ON_NOTICE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

enum HREmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  AD_HOC
  INTERN
  VISITING
}

enum HRContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum HRLeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum HRHolidayType {
  NATIONAL
  REGIONAL
  INSTITUTIONAL
  RESTRICTED
}

enum HRDocumentCategory {
  CONTRACT
  IDENTIFICATION
  QUALIFICATION
  OFFER_LETTER
  RELIEVING_LETTER
  APPRAISAL
  OTHER
}

model HRDepartment {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  parentDepartmentId String?
  parentDepartment   HRDepartment?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     HRDepartment[] @relation("DepartmentHierarchy")
  headStaffId        String?
  headStaff          StaffProfile?  @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  employments HREmployment[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model HRDesignation {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  level       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employments HREmployment[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model HRWorkLocation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employments HREmployment[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model HREmployment {
  id                      String             @id @default(cuid())
  tenantId                String
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfileId          String             @unique
  staffProfile            StaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  employeeNumber          String
  status                  HREmploymentStatus @default(ACTIVE)
  employmentType          HREmploymentType   @default(FULL_TIME)
  departmentId            String?
  department              HRDepartment?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId           String?
  designation             HRDesignation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  workLocationId          String?
  workLocation            HRWorkLocation?    @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  reportingManagerStaffId String?
  joiningDate             DateTime
  confirmationDate        DateTime?
  exitDate                DateTime?
  exitReason              String?
  emergencyContactJson    String?            @db.Text
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  contracts           HREmploymentContract[]
  histories           HREmploymentHistory[]
  leaveBalances       HRLeaveBalance[]
  leaveRequests       HRLeaveRequest[]
  documents           HREmployeeDocument[]
  compensations       EmployeeCompensation[]
  payrollCalculations PayrollCalculation[]
  payslips            Payslip[]
  payrollAdjustments  PayrollAdjustment[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, staffProfileId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
}

model HREmploymentHistory {
  id                    String              @id @default(cuid())
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId          String
  employment            HREmployment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  changeDate            DateTime            @default(now())
  previousDepartmentId  String?
  newDepartmentId       String?
  previousDesignationId String?
  newDesignationId      String?
  previousStatus        HREmploymentStatus?
  newStatus             HREmploymentStatus?
  reason                String?             @db.Text
  changedByUserId       String?
  createdAt             DateTime            @default(now())

  @@index([tenantId, employmentId])
}

model HREmploymentContract {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId        String
  employment          HREmployment     @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  contractNumber      String
  employmentType      HREmploymentType @default(FULL_TIME)
  startDate           DateTime
  endDate             DateTime?
  probationPeriodDays Int?
  noticePeriodDays    Int?
  status              HRContractStatus @default(DRAFT)
  documentReferenceId String?
  notes               String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([tenantId, contractNumber])
  @@index([tenantId, employmentId])
  @@index([tenantId, status])
}

model HRHolidayCalendar {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  academicYearId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  holidays HRHoliday[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model HRHoliday {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendarId  String
  calendar    HRHolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  holidayType HRHolidayType     @default(INSTITUTIONAL)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tenantId, calendarId, date])
  @@index([tenantId, date])
}

model HRLeaveType {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  daysAllowedPerYear Decimal  @db.Decimal(5, 2)
  isPaid             Boolean  @default(true)
  carryForwardDays   Decimal  @default(0) @db.Decimal(5, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  balances HRLeaveBalance[]
  requests HRLeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model HRLeaveBalance {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId  String
  employment    HREmployment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     HRLeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year          Int
  allocatedDays Decimal      @db.Decimal(5, 2)
  usedDays      Decimal      @default(0) @db.Decimal(5, 2)
  pendingDays   Decimal      @default(0) @db.Decimal(5, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([tenantId, employmentId, leaveTypeId, year])
  @@index([tenantId, employmentId])
}

model HRLeaveRequest {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId     String
  employment       HREmployment  @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  leaveTypeId      String
  leaveType        HRLeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate        DateTime
  endDate          DateTime
  daysCount        Decimal       @db.Decimal(5, 2)
  reason           String?       @db.Text
  status           HRLeaveStatus @default(SUBMITTED)
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId, employmentId])
  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
}

model HRWorkSchedule {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  code               String
  workingDaysJson    String   @db.Text
  expectedDailyHours Decimal  @default(8.00) @db.Decimal(4, 2)
  shiftStart         String?
  shiftEnd           String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model HREmployeeDocument {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId        String
  employment          HREmployment       @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  documentReferenceId String
  documentReference   DocumentReference  @relation(fields: [documentReferenceId], references: [id], onDelete: Restrict)
  category            HRDocumentCategory @default(OTHER)
  title               String
  expiryDate          DateTime?
  isVerified          Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId, employmentId])
  @@index([documentReferenceId])
}

// ============================================================================
// PLANE 20: PAYROLL MANAGEMENT (V2 WAVE 5)
// ============================================================================

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  CALCULATED
  UNDER_REVIEW
  APPROVED
  FINALIZED
  LOCKED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  CALCULATED
  UNDER_REVIEW
  APPROVED
  FINALIZED
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum SalaryCalculationMethod {
  FIXED
  PERCENTAGE_OF_BASIC
  PERCENTAGE_OF_GROSS
  DAYS_BASED
  MANUAL
}

enum PayrollAdjustmentType {
  ARREARS
  BONUS
  REIMBURSEMENT
  DEDUCTION_CORRECTION
  UNPAID_LEAVE_DEDUCTION
  MANUAL_ADJUSTMENT
}

enum PayrollAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model SalaryComponent {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String?
  type              SalaryComponentType     @default(EARNING)
  calculationMethod SalaryCalculationMethod @default(FIXED)
  defaultAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  percentage        Decimal                 @default(0) @db.Decimal(5, 2)
  isTaxable         Boolean                 @default(true)
  isRecurring       Boolean                 @default(true)
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  structureItems    SalaryStructureItem[]
  compensationItems EmployeeCompensationItem[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, active])
}

model SalaryStructure {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         SalaryStructureItem[]
  compensations EmployeeCompensation[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model SalaryStructureItem {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  amount      Decimal         @default(0) @db.Decimal(12, 2)
  percentage  Decimal         @default(0) @db.Decimal(5, 2)
  createdAt   DateTime        @default(now())

  @@unique([structureId, componentId])
  @@index([tenantId])
}

model EmployeeCompensation {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId      String
  employment        HREmployment     @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  basicSalary       Decimal          @db.Decimal(12, 2)
  grossSalary       Decimal          @db.Decimal(12, 2)
  status            String           @default("ACTIVE")
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items EmployeeCompensationItem[]

  @@index([tenantId, employmentId])
  @@index([tenantId, status])
}

model EmployeeCompensationItem {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  compensationId    String
  compensation      EmployeeCompensation    @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  componentId       String
  component         SalaryComponent         @relation(fields: [componentId], references: [id], onDelete: Restrict)
  amount            Decimal                 @db.Decimal(12, 2)
  calculationMethod SalaryCalculationMethod @default(FIXED)
  createdAt         DateTime                @default(now())

  @@unique([compensationId, componentId])
  @@index([tenantId])
}

model PayrollPeriod {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime
  endDate      DateTime
  status       PayrollPeriodStatus @default(OPEN)
  fiscalYearId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  runs     PayrollRun[]
  payslips Payslip[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model PayrollRun {
  id                         String           @id @default(cuid())
  tenantId                   String
  tenant                     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodId                   String
  period                     PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  runNumber                  String
  status                     PayrollRunStatus @default(DRAFT)
  calculationVersion         Int              @default(1)
  totalEmployees             Int              @default(0)
  totalGrossEarnings         Decimal          @default(0) @db.Decimal(14, 2)
  totalEmployeeDeductions    Decimal          @default(0) @db.Decimal(14, 2)
  totalEmployerContributions Decimal          @default(0) @db.Decimal(14, 2)
  totalNetPay                Decimal          @default(0) @db.Decimal(14, 2)
  createdByUserId            String
  calculatedAt               DateTime?
  approvedByUserId           String?
  approvedAt                 DateTime?
  finalizedByUserId          String?
  finalizedAt                DateTime?
  journalEntryId             String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  calculations      PayrollCalculation[]
  payslips          Payslip[]
  accountingPosting PayrollAccountingPosting?

  @@unique([tenantId, periodId, runNumber])
  @@index([tenantId, status])
}

model PayrollCalculation {
  id                    String       @id @default(cuid())
  tenantId              String
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId          String
  payrollRun            PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employmentId          String
  employment            HREmployment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  workingDays           Decimal      @default(30) @db.Decimal(5, 2)
  presentDays           Decimal      @default(30) @db.Decimal(5, 2)
  absentDays            Decimal      @default(0) @db.Decimal(5, 2)
  unpaidLeaveDays       Decimal      @default(0) @db.Decimal(5, 2)
  grossEarnings         Decimal      @db.Decimal(12, 2)
  totalDeductions       Decimal      @db.Decimal(12, 2)
  employerContributions Decimal      @default(0) @db.Decimal(12, 2)
  netPay                Decimal      @db.Decimal(12, 2)
  taxableAmount         Decimal      @default(0) @db.Decimal(12, 2)
  lineItemsJson         String       @db.Text
  createdAt             DateTime     @default(now())

  @@unique([payrollRunId, employmentId])
  @@index([tenantId, employmentId])
}

model Payslip {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId       String
  payrollRun         PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employmentId       String
  employment         HREmployment  @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  periodId           String
  period             PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  payslipNumber      String
  employeeName       String
  employeeNumber     String
  departmentName     String?
  designationName    String?
  bankAccountMasked  String?
  grossEarnings      Decimal       @db.Decimal(12, 2)
  totalDeductions    Decimal       @db.Decimal(12, 2)
  netPay             Decimal       @db.Decimal(12, 2)
  calculationVersion Int           @default(1)
  snapshotJson       String        @db.Text
  isPublished        Boolean       @default(false)
  generatedAt        DateTime      @default(now())

  @@unique([tenantId, payslipNumber])
  @@unique([payrollRunId, employmentId])
  @@index([tenantId, employmentId])
}

model PayrollAdjustment {
  id                    String                  @id @default(cuid())
  tenantId              String
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId          String
  employment            HREmployment            @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  periodId              String?
  adjustmentType        PayrollAdjustmentType   @default(MANUAL_ADJUSTMENT)
  amount                Decimal                 @db.Decimal(12, 2)
  reason                String                  @db.Text
  status                PayrollAdjustmentStatus @default(PENDING)
  requestedByUserId     String
  approvedByUserId      String?
  appliedInPayrollRunId String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([tenantId, employmentId])
  @@index([tenantId, status])
}

model PayrollAccountingPosting {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId   String     @unique
  payrollRun     PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  journalEntryId String
  totalExpense   Decimal    @db.Decimal(14, 2)
  totalPayable   Decimal    @db.Decimal(14, 2)
  postedAt       DateTime   @default(now())
  postedByUserId String

  @@unique([tenantId, payrollRunId])
  @@index([journalEntryId])
}
