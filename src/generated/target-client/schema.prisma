// ============================================================================
// PLANE 1: PLATFORM & SAAS CONTROL PLANE
// ============================================================================

model Tenant {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  legalName        String
  affiliationBoard String?
  affiliationCode  String?
  status           TenantStatus @default(PROVISIONING)
  currency         String       @default("INR")
  timezone         String       @default("Asia/Kolkata")
  locale           String       @default("en-IN")
  logoUrl          String?
  planTier         String       @default("STARTER")
  studentQuota     Int          @default(500)
  staffQuota       Int          @default(50)
  storageQuotaGb   Int          @default(10)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  policy             TenantPolicy?
  branding           TenantBranding?
  domains            TenantDomain[]
  memberships        TenantMembership[]
  customRoles        Role[]
  moduleEntitlements TenantModuleEntitlement[]
  invitations        TenantInvitation[]
  academicYears      AcademicYear[]
  terms              Term[]
  grades             Grade[]
  classes            Class[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  staffProfiles      StaffProfile[]
  studentProfiles    StudentProfile[]
  parentProfiles     ParentProfile[]
  studentBindings    StudentParentBinding[]
  enrollments        StudentEnrollment[]
  academicHistories  StudentAcademicHistory[]
  periods            TimetablePeriod[]
  lessons            TimetableLesson[]
  attendanceRecords  AttendanceRecord[]
  attendanceSummary  AttendanceDailySummary[]
  exams              Exam[]
  examPapers         ExamPaper[]
  gradingSchemes     GradingScheme[]
  examResults        ExamResult[]
  reportCards        ReportCard[]
  assignments        Assignment[]
  submissions        AssignmentSubmission[]
  announcements      Announcement[]
  events             Event[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  documents          DocumentReference[]

  // Plane 11, 12, 13 (V2 Wave 1: Fees, Payments, GL) & Outbox
  feeCategories         FeeCategory[]
  feeStructures         FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  feeDiscounts          FeeDiscount[]
  feeInvoices           FeeInvoice[]
  feeInvoiceItems       FeeInvoiceItem[]
  paymentGatewayConfigs PaymentGatewayConfig[]
  paymentIntents        PaymentIntent[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  paymentRefunds        PaymentRefund[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  fiscalYears           FiscalYear[]
  financialPeriods      FinancialPeriod[]
  chartOfAccounts       ChartOfAccount[]
  ledgerAccounts        LedgerAccount[]
  journalEntries        JournalEntry[]
  journalLines          JournalLine[]
  outboxEvents          TenantOutboxEvent[]

  // Plane 14: Admissions & Enquiry CRM (V2 Wave 2)
  admissionSessions      AdmissionSession[]
  admissionSources       AdmissionSource[]
  admissionEnquiries     AdmissionEnquiry[]
  applicants             Applicant[]
  admissionApplications  AdmissionApplication[]
  admissionDocuments     AdmissionApplicationDocument[]
  admissionInterviews    AdmissionInterview[]
  admissionTests         AdmissionTest[]
  admissionDecisions     AdmissionDecision[]
  admissionOffers        AdmissionOffer[]
  admissionConfirmations AdmissionConfirmation[]

  // Plane 15: Library Management (V2 Wave 3)
  libraries           Library[]
  libraryCategories   LibraryCategory[]
  libraryAuthors      LibraryAuthor[]
  libraryPublishers   LibraryPublisher[]
  libraryBooks        LibraryBook[]
  libraryCopies       LibraryBookCopy[]
  libraryMembers      LibraryMember[]
  libraryLoans        LibraryLoan[]
  libraryReservations LibraryReservation[]
  libraryFines        LibraryFine[]
  libraryPolicies     LibraryPolicy[]

  // Plane 16: Transport Management (V2 Wave 3)
  transportFacilities         TransportFacility[]
  transportRoutes             TransportRoute[]
  transportStops              TransportStop[]
  transportVehicles           TransportVehicle[]
  transportDrivers            TransportDriver[]
  transportAttendants         TransportAttendant[]
  transportRouteAssignments   TransportRouteAssignment[]
  studentTransportAssignments StudentTransportAssignment[]
  transportPasses             TransportPass[]
  transportIncidents          TransportIncident[]

  // Plane 17: Inventory Management (V2 Wave 4)
  inventoryCategories           InventoryCategory[]
  inventoryUnits                InventoryUnit[]
  inventoryVendors              InventoryVendor[]
  inventoryWarehouses           InventoryWarehouse[]
  inventoryLocations            InventoryLocation[]
  inventoryItems                InventoryItem[]
  inventoryStocks               InventoryStock[]
  inventoryStockLots            InventoryStockLot[]
  inventoryStockMovements       InventoryStockMovement[]
  inventoryPurchaseRequests     InventoryPurchaseRequest[]
  inventoryPurchaseRequestItems InventoryPurchaseRequestItem[]
  inventoryPurchaseOrders       InventoryPurchaseOrder[]
  inventoryPurchaseOrderItems   InventoryPurchaseOrderItem[]
  inventoryReceipts             InventoryReceipt[]
  inventoryReceiptItems         InventoryReceiptItem[]
  inventoryIssues               InventoryIssue[]
  inventoryIssueItems           InventoryIssueItem[]
  inventoryTransfers            InventoryTransfer[]
  inventoryTransferItems        InventoryTransferItem[]
  inventoryAdjustments          InventoryAdjustment[]
  inventoryAdjustmentItems      InventoryAdjustmentItem[]
  inventoryReservations         InventoryReservation[]
  inventoryReorderRules         InventoryReorderRule[]
  inventoryValuationSnapshots   InventoryValuationSnapshot[]

  // Plane 18: Fixed Asset Management (V2 Wave 4)
  assetCategories    AssetCategory[]
  assets             Asset[]
  assetComponents    AssetComponent[]
  assetAssignments   AssetAssignment[]
  assetTransfers     AssetTransfer[]
  assetReturns       AssetReturn[]
  assetMaintenances  AssetMaintenance[]
  assetDisposals     AssetDisposal[]
  assetDepreciations AssetDepreciation[]

  // Plane 19: Human Resources (V2 Wave 5)
  hrDepartments         HRDepartment[]
  hrDesignations        HRDesignation[]
  hrWorkLocations       HRWorkLocation[]
  hrEmployments         HREmployment[]
  hrEmploymentHistories HREmploymentHistory[]
  hrEmploymentContracts HREmploymentContract[]
  hrHolidayCalendars    HRHolidayCalendar[]
  hrHolidays            HRHoliday[]
  hrLeaveTypes          HRLeaveType[]
  hrLeaveBalances       HRLeaveBalance[]
  hrLeaveRequests       HRLeaveRequest[]
  hrWorkSchedules       HRWorkSchedule[]
  hrEmployeeDocuments   HREmployeeDocument[]

  // Plane 20: Payroll Management (V2 Wave 5)
  salaryComponents          SalaryComponent[]
  salaryStructures          SalaryStructure[]
  salaryStructureItems      SalaryStructureItem[]
  employeeCompensations     EmployeeCompensation[]
  employeeCompensationItems EmployeeCompensationItem[]
  payrollPeriods            PayrollPeriod[]
  payrollRuns               PayrollRun[]
  payrollCalculations       PayrollCalculation[]
  payslips                  Payslip[]
  payrollAdjustments        PayrollAdjustment[]
  payrollAccountingPostings PayrollAccountingPosting[]

  @@index([status])
  @@index([createdAt])
}

model TenantPolicy {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  attendanceCutoffTime              String  @default("10:30")
  attendanceWarningThresholdPercent Decimal @default(75.0) @db.Decimal(5, 2)
  autoSmsOnAbsence                  Boolean @default(true)
  defaultPassingPercentage          Decimal @default(33.0) @db.Decimal(5, 2)
  allowParentPortalRegistration     Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model TenantBranding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  crestLogoUrl          String?
  primaryColorHex       String  @default("#0284c7")
  principalSignatureUrl String?
  reportCardHeaderHtml  String? @db.Text
  reportCardFooterHtml  String? @db.Text

  updatedAt DateTime @updatedAt
}

model TenantDomain {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  domainName String  @unique
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)
  sslStatus  String  @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SubscriptionPlan {
  id                     String  @id @default(cuid())
  planKey                String  @unique
  name                   String
  description            String?
  monthlyPricePerStudent Decimal @db.Decimal(10, 2)
  annualDiscountPercent  Decimal @default(15.0) @db.Decimal(5, 2)
  includedModulesJson    String  @db.Text // JSON array of module keys
  isPublic               Boolean @default(true)
  isActive               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id          String  @id @default(cuid())
  moduleKey   String  @unique
  displayName String
  isCore      Boolean @default(false)
  description String?

  entitlements TenantModuleEntitlement[]
}

model TenantModuleEntitlement {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey String
  module    Module @relation(fields: [moduleKey], references: [moduleKey], onDelete: Restrict)

  isEnabled Boolean           @default(true)
  source    EntitlementSource @default(PLAN_INCLUDED)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleKey])
  @@index([tenantId, isEnabled])
}

model LeadInquiry {
  id              String     @id @default(cuid())
  schoolName      String
  contactPerson   String
  email           String
  phone           String
  institutionType String
  studentStrength Int
  city            String
  state           String
  status          LeadStatus @default(NEW)
  notes           String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PLANE 2: IDENTITY, MEMBERSHIP & DYNAMIC RBAC
// ============================================================================

model User {
  id              String  @id @default(cuid())
  clerkId         String  @unique
  email           String  @unique
  phone           String?
  firstName       String
  lastName        String
  displayName     String?
  avatarUrl       String?
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  platformUser         PlatformUser?
  preference           UserPreference?
  memberships          TenantMembership[]
  staffProfiles        StaffProfile[]
  studentProfiles      StudentProfile[]
  parentProfiles       ParentProfile[]
  notificationSettings NotificationPreference[]
  notifications        Notification[]
  uploadedDocuments    DocumentReference[]
  auditLogs            AuditLog[]

  // Plane 14: Admissions Relations
  assignedEnquiries    AdmissionEnquiry[]
  reviewedApplications AdmissionApplication[]
  verifiedDocuments    AdmissionApplicationDocument[]
  conductedInterviews  AdmissionInterview[]
  evaluatedTests       AdmissionTest[]
  admissionDecisions   AdmissionDecision[]
  confirmedAdmissions  AdmissionConfirmation[]

  // Plane 15 & 16: Library & Transport Relations
  libraryMembers             LibraryMember[]
  issuedLibraryLoans         LibraryLoan[]        @relation("LibraryLoanIssuer")
  returnedLibraryLoans       LibraryLoan[]        @relation("LibraryLoanReceiver")
  waivedLibraryFines         LibraryFine[]        @relation("LibraryFineWaiver")
  transportDrivers           TransportDriver[]
  transportAttendants        TransportAttendant[]
  reportedTransportIncidents TransportIncident[]  @relation("TransportIncidentReporter")
  resolvedTransportIncidents TransportIncident[]  @relation("TransportIncidentResolver")

  @@index([email])
  @@index([clerkId])
}

model PlatformUser {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @default(SUPPORT_OPERATOR)
  isActive     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredLanguage  String  @default("en")
  theme              String  @default("SYSTEM")
  lastActiveTenantId String?

  updatedAt DateTime @updatedAt
}

model TenantMembership {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status   MembershipStatus @default(ACTIVE)

  joinedAt     DateTime  @default(now())
  invitedAt    DateTime?
  terminatedAt DateTime?

  // Relational link to staff if applicable
  staffProfile StaffProfile?

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
}

model Role {
  id           String  @id @default(cuid())
  tenantId     String? // null indicates platform-wide system role
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleKey      String
  name         String
  description  String?
  isSystemRole Boolean @default(false)

  memberships TenantMembership[]
  permissions RolePermission[]
  invitations TenantInvitation[]

  @@unique([tenantId, roleKey])
  @@index([isSystemRole])
}

model Permission {
  id            String @id @default(cuid())
  permissionKey String @unique // e.g. attendance.mark, exam.publish
  moduleKey     String
  verb          String
  description   String

  roleBindings RolePermission[]

  @@index([moduleKey])
}

model RolePermission {
  id           String      @id @default(cuid())
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  accessScope  AccessScope @default(INSTITUTION_WIDE)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model TenantInvitation {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  phone           String?
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitationToken String   @unique
  expiresAt       DateTime
  status          String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, email])
  @@index([invitationToken])
}

// ============================================================================
// PLANE 3: ACADEMIC CALENDAR & STRUCTURE
// ============================================================================

model AcademicYear {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  yearLabel String // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  status    AcademicSessionStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms                       Term[]
  classes                     Class[]
  enrollments                 StudentEnrollment[]
  academicHistories           StudentAcademicHistory[]
  lessons                     TimetableLesson[]
  exams                       Exam[]
  events                      Event[]
  reportCards                 ReportCard[]
  assignments                 Assignment[]
  feeStructures               FeeStructure[]
  studentFeeAssignments       StudentFeeAssignment[]
  feeInvoices                 FeeInvoice[]
  fiscalYears                 FiscalYear[]
  admissionSessions           AdmissionSession[]
  studentTransportAssignments StudentTransportAssignment[]

  @@unique([tenantId, yearLabel])
  @@index([tenantId, status])
}

model Term {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termName       String // e.g. "Term 1"
  termOrder      Int
  startDate      DateTime
  endDate        DateTime

  exams       Exam[]
  reportCards ReportCard[]

  @@unique([tenantId, academicYearId, termName])
  @@index([academicYearId])
}

model Grade {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevel Int // 1 through 12, or negative for Pre-K
  name       String // e.g. "Grade 10"

  classes               Class[]
  feeStructures         FeeStructure[]
  admissionApplications AdmissionApplication[]
  admissionOffers       AdmissionOffer[]
  admissionEnquiries    AdmissionEnquiry[]

  @@unique([tenantId, gradeLevel])
  @@index([tenantId])
}

model Class {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeId         String
  grade           Grade        @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  sectionName     String // e.g. "A", "B"
  roomNumber      String?
  studentCapacity Int          @default(40)

  supervisorTeacherId String?
  supervisorTeacher   StaffProfile? @relation("ClassSupervisor", fields: [supervisorTeacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects         ClassSubject[]
  enrollments           StudentEnrollment[]
  lessons               TimetableLesson[]
  attendanceRecords     AttendanceRecord[]
  attendanceSummaries   AttendanceDailySummary[]
  examPapers            ExamPaper[]
  assignments           Assignment[]
  reportCards           ReportCard[]
  feeInvoices           FeeInvoice[]
  admissionApplications AdmissionApplication[]
  admissionOffers       AdmissionOffer[]

  @@unique([tenantId, academicYearId, gradeId, sectionName])
  @@index([tenantId, academicYearId])
  @@index([supervisorTeacherId])
}

model Subject {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectCode String // e.g. "MATH-10"
  name        String
  subjectType SubjectType @default(THEORY)
  maxMarks    Decimal     @default(100.0) @db.Decimal(5, 2)
  passMarks   Decimal     @default(33.0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  lessons       TimetableLesson[]
  examPapers    ExamPaper[]
  assignments   Assignment[]

  @@unique([tenantId, subjectCode])
  @@index([tenantId])
}

model ClassSubject {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId String
  teacher   StaffProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([tenantId, classId, subjectId])
  @@index([teacherId])
}

// ============================================================================
// PLANE 4: PEOPLE & PROFILES
// ============================================================================

model StaffProfile {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  membershipId String           @unique
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  employeeId       String
  fullName         String
  gender           Gender
  designation      String
  department       String?
  dateOfJoining    DateTime
  qualifications   String?
  emergencyPhone   String?
  maskedNationalId String?
  status           StaffStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  supervisedClasses Class[]              @relation("ClassSupervisor")
  assignedSubjects  ClassSubject[]
  scheduledLessons  TimetableLesson[]
  postedAssignments Assignment[]
  managedWarehouses InventoryWarehouse[]
  hrEmployment      HREmployment?
  headedDepartments HRDepartment[]       @relation("DepartmentHead")

  @@unique([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([userId])
}

model StudentProfile {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String? // Optional digital portal account
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  admissionNumber  String
  fullName         String
  gender           Gender
  dateOfBirth      DateTime
  bloodGroup       BloodGroup    @default(UNKNOWN)
  address          String?       @db.Text
  medicalNotes     String?       @db.Text
  maskedNationalId String?
  status           StudentStatus @default(ACTIVE)
  admissionDate    DateTime      @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments           StudentEnrollment[]
  academicHistories     StudentAcademicHistory[]
  guardians             StudentParentBinding[]
  attendanceRecords     AttendanceRecord[]
  examResults           ExamResult[]
  submissions           AssignmentSubmission[]
  reportCards           ReportCard[]
  feeAssignments        StudentFeeAssignment[]
  feeInvoices           FeeInvoice[]
  paymentIntents        PaymentIntent[]
  payments              Payment[]
  applicants            Applicant[]
  admissionApplications AdmissionApplication[]
  libraryMembers        LibraryMember[]
  transportAssignments  StudentTransportAssignment[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, status])
  @@index([userId])
}

model ParentProfile {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName       String
  primaryPhone   String
  secondaryPhone String?
  email          String?
  occupation     String?
  address        String? @db.Text
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children StudentParentBinding[]
  payments Payment[]

  @@unique([tenantId, primaryPhone])
  @@index([tenantId])
  @@index([userId])
}

model StudentParentBinding {
  id               String                 @id @default(cuid())
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId         String
  parent           ParentProfile          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relationshipType ParentRelationshipType @default(LEGAL_GUARDIAN)

  isPrimaryContact   Boolean @default(true)
  isFeePayer         Boolean @default(false)
  isEmergencyContact Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([tenantId, studentId, parentId])
  @@index([parentId])
  @@index([studentId])
}

model StudentEnrollment {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  class          Class          @relation(fields: [classId], references: [id], onDelete: Restrict)

  rollNumber     Int
  enrollmentDate DateTime      @default(now())
  status         StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, academicYearId, studentId])
  @@unique([tenantId, classId, rollNumber])
  @@index([tenantId, classId, status])
}

model StudentAcademicHistory {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId    String
  academicYear      AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId           String
  promotedToClassId String?

  finalAttendanceRate Decimal           @db.Decimal(5, 2)
  aggregatePercentage Decimal           @db.Decimal(5, 2)
  cumulativeGpa       Decimal?          @db.Decimal(4, 2)
  promotionDecision   PromotionDecision @default(PROMOTED)
  decisionDate        DateTime          @default(now())
  finalRemarks        String?           @db.Text

  @@unique([tenantId, academicYearId, studentId])
  @@index([studentId])
}

// ============================================================================
// PLANE 5: TIMETABLE & SCHEDULING
// ============================================================================

model TimetablePeriod {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodNumber Int
  name         String // e.g. "Period 1", "Lunch Break"
  startTime    String // "09:00"
  endTime      String // "09:45"
  isBreak      Boolean @default(false)

  lessons TimetableLesson[]

  @@unique([tenantId, periodNumber])
  @@index([tenantId])
}

model TimetableLesson {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId      String
  teacher        StaffProfile    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  periodId       String
  period         TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  dayOfWeek      DayOfWeek
  roomNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, teacherId, academicYearId, dayOfWeek, periodId])
  @@unique([tenantId, classId, academicYearId, dayOfWeek, periodId])
  @@index([tenantId, classId, dayOfWeek])
  @@index([tenantId, teacherId, dayOfWeek])
}

// ============================================================================
// PLANE 6: ATTENDANCE
// ============================================================================

model AttendanceRecord {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  classId        String
  class          Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  date           DateTime // Clamped to midnight UTC YYYY-MM-DD
  status         AttendanceStatus @default(PRESENT)
  remarks        String?
  markedByUserId String
  markedAt       DateTime         @default(now())
  isLocked       Boolean          @default(false)

  corrections AttendanceCorrection[]

  @@unique([tenantId, classId, date, studentId])
  @@index([tenantId, studentId, date])
  @@index([tenantId, date, status])
  @@index([tenantId, classId, date])
}

model AttendanceCorrection {
  id                 String           @id @default(cuid())
  tenantId           String
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  previousStatus    AttendanceStatus
  newStatus         AttendanceStatus
  reason            String           @db.Text
  requestedByUserId String
  approvedByUserId  String
  approvedAt        DateTime         @default(now())

  @@index([attendanceRecordId])
}

model AttendanceDailySummary {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date           DateTime

  totalEnrolled        Int
  totalPresent         Int
  totalAbsent          Int
  totalLate            Int
  attendancePercentage Decimal  @db.Decimal(5, 2)
  submittedAt          DateTime @default(now())

  @@unique([tenantId, classId, date])
  @@index([tenantId, date])
}

// ============================================================================
// PLANE 7: ASSIGNMENTS & HOMEWORK
// ============================================================================

model Assignment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId      String
  teacher        StaffProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  title                String
  instructionsMarkdown String           @db.Text
  maxMarks             Decimal?         @db.Decimal(5, 2)
  assignedDate         DateTime         @default(now())
  dueDate              DateTime
  attachmentUrlsJson   String?          @db.Text
  status               AssignmentStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([tenantId, classId, dueDate])
  @@index([teacherId])
}

model AssignmentSubmission {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  submittedAt        DateTime         @default(now())
  submissionFileUrls String?          @db.Text
  studentNotes       String?          @db.Text
  marksAwarded       Decimal?         @db.Decimal(5, 2)
  teacherFeedback    String?          @db.Text
  gradedByUserId     String?
  gradedAt           DateTime?
  status             SubmissionStatus @default(SUBMITTED)

  @@unique([tenantId, assignmentId, studentId])
  @@index([assignmentId, status])
}

// ============================================================================
// PLANE 8: EXAMINATIONS, GRADING & REPORT CARDS
// ============================================================================

model Exam {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Restrict)

  title        String // e.g. "Term 1 Summative Assessment"
  startDate    DateTime
  endDate      DateTime
  instructions String?    @db.Text
  status       ExamStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers ExamPaper[]

  @@index([tenantId, status])
  @@index([academicYearId, termId])
}

model ExamPaper {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  examDate   DateTime
  startTime  String // "09:00"
  endTime    String // "12:00"
  maxMarks   Decimal  @default(100.0) @db.Decimal(5, 2)
  passMarks  Decimal  @default(33.0) @db.Decimal(5, 2)
  roomNumber String?

  results ExamResult[]

  @@unique([tenantId, examId, classId, subjectId])
  @@index([tenantId, examId])
  @@index([classId])
}

model GradingScheme {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schemeName String // e.g. "CBSE 9-Point Scale"
  isDefault  Boolean @default(false)
  rulesJson  String  @db.Text // JSON array of grade bands

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schemeName])
}

model ExamResult {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examPaperId String
  examPaper   ExamPaper      @relation(fields: [examPaperId], references: [id], onDelete: Restrict)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  theoryMarks     Decimal  @default(0.0) @db.Decimal(5, 2)
  practicalMarks  Decimal? @db.Decimal(5, 2)
  totalMarks      Decimal  @db.Decimal(5, 2)
  isAbsent        Boolean  @default(false)
  percentage      Decimal  @db.Decimal(5, 2)
  gradeLetter     String?
  gradePoint      Decimal? @db.Decimal(4, 2)
  remarks         String?
  enteredByUserId String
  isVerified      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, examPaperId, studentId])
  @@index([tenantId, examPaperId])
  @@index([studentId])
}

model ReportCard {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String
  term           Term           @relation(fields: [termId], references: [id], onDelete: Restrict)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId        String
  class          Class          @relation(fields: [classId], references: [id], onDelete: Restrict)

  grandTotal            Decimal          @db.Decimal(7, 2)
  totalMaxMarks         Decimal          @db.Decimal(7, 2)
  aggregatePercentage   Decimal          @db.Decimal(5, 2)
  overallGrade          String
  attendanceRatePercent Decimal          @db.Decimal(5, 2)
  classRank             Int?
  coScholasticJson      String?          @db.Text
  teacherRemarks        String?          @db.Text
  principalRemarks      String?          @db.Text
  pdfSnapshotUrl        String?
  status                ReportCardStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, academicYearId, termId, studentId])
  @@index([tenantId, classId, termId])
  @@index([studentId])
}

// ============================================================================
// PLANE 9: COMMUNICATIONS & NOTIFICATIONS
// ============================================================================

model Announcement {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title               String
  category            AnnouncementCategory @default(GENERAL)
  bodyMarkdown        String               @db.Text
  attachmentUrlsJson  String?              @db.Text
  targetAudienceScope AudienceScope        @default(ALL_SCHOOL)
  targetRolesJson     String?              @db.Text
  targetGradesJson    String?              @db.Text
  isUrgent            Boolean              @default(false)
  publishedAt         DateTime             @default(now())
  authorUserId        String
  status              String               @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isUrgent, publishedAt])
}

model Event {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  title              String
  eventType          EventType @default(GENERAL)
  startDateTime      DateTime
  endDateTime        DateTime
  allDay             Boolean   @default(false)
  isSchoolClosed     Boolean   @default(false)
  location           String?
  targetAudienceJson String?   @db.Text
  description        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startDateTime])
  @@index([academicYearId])
}

model Notification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType   String // e.g. ATTENDANCE_ABSENT, RESULT_PUBLISHED
  title       String
  message     String    @db.Text
  deepLinkUrl String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isRead, createdAt])
  @@index([tenantId, createdAt])
}

model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory

  inAppEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)
  smsEnabled   Boolean @default(false)
  emailEnabled Boolean @default(true)

  @@unique([userId, category])
}

// ============================================================================
// PLANE 10: AUDIT & FILES
// ============================================================================

model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String? // null for platform-wide SaaS operator actions
  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  actionCategory AuditActionCategory
  action         String // e.g. "STUDENT_ENROLLED", "ATTENDANCE_CORRECTED"
  entityType     String // e.g. "StudentProfile", "ExamResult"
  entityId       String
  diffJson       String?             @db.Text // Old vs new value diffs
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model DocumentReference {
  id               String @id @default(cuid())
  tenantId         String
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploader         User   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  storageProvider StorageProvider @default(CLOUDFLARE_R2)
  bucketName      String
  storageKey      String          @unique
  fileName        String
  fileMimeType    String
  fileSizeBytes   BigInt
  sha256Checksum  String?
  accessLevel     FileAccessLevel @default(PRIVATE)
  entityType      String // e.g. "Assignment", "ReportCard"
  entityId        String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  admissionDocuments  AdmissionApplicationDocument[]
  hrEmployeeDocuments HREmployeeDocument[]

  @@index([tenantId, entityType, entityId])
  @@index([uploadedByUserId])
}

// ============================================================================
// PLANE 11: FEES & INVOICING (V2 WAVE 1)
// ============================================================================

model FeeCategory {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structureItems FeeStructureItem[]
  invoiceItems   FeeInvoiceItem[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model FeeStructure {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeId        String?
  grade          Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  totalAmount    Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       FeeStructureItem[]
  assignments StudentFeeAssignment[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, academicYearId])
}

model FeeStructureItem {
  id             String       @id @default(cuid())
  tenantId       String
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategoryId  String
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  name           String
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency @default(ANNUAL)
  dueDayOfMonth  Int?         @default(10)
  dueMonth       Int?
  isOptional     Boolean      @default(false)

  invoiceItems FeeInvoiceItem[]

  @@index([feeStructureId])
  @@index([tenantId])
}

model StudentFeeAssignment {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId   String
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  feeStructureId   String
  feeStructure     FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  baseAmount       Decimal        @db.Decimal(10, 2)
  concessionAmount Decimal        @default(0.0) @db.Decimal(10, 2)
  netPayableAmount Decimal        @db.Decimal(10, 2)
  discountReason   String?
  status           String         @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, academicYearId, studentId])
  @@index([tenantId, studentId])
}

model FeeDiscount {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  discountType       DiscountType @default(FIXED_AMOUNT)
  percentageOrAmount Decimal      @db.Decimal(10, 2)
  reason             String
  isActive           Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model FeeInvoice {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String?
  class          Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)

  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotalAmount Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.0) @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0.0) @db.Decimal(10, 2)
  balanceAmount  Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(ISSUED)
  notes          String?       @db.Text
  journalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       FeeInvoiceItem[]
  allocations PaymentAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
}

model FeeInvoiceItem {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId          String
  invoice            FeeInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureItemId String?
  feeStructureItem   FeeStructureItem? @relation(fields: [feeStructureItemId], references: [id], onDelete: SetNull)
  feeCategoryId      String
  feeCategory        FeeCategory       @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  description        String
  amount             Decimal           @db.Decimal(10, 2)
  paidAmount         Decimal           @default(0.0) @db.Decimal(10, 2)

  allocations PaymentAllocation[]

  @@index([invoiceId])
  @@index([tenantId])
}

// ============================================================================
// PLANE 12: PAYMENTS & GATEWAYS (V2 WAVE 1)
// ============================================================================

model PaymentGatewayConfig {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider      PaymentGatewayProvider
  keyId         String
  keySecretHash String
  webhookSecret String?
  isLive        Boolean                @default(false)
  isEnabled     Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
}

model PaymentIntent {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  amount          Decimal                @db.Decimal(10, 2)
  currency        String                 @default("INR")
  provider        PaymentGatewayProvider
  gatewayOrderId  String                 @unique
  gatewayChecksum String?
  status          PaymentStatus          @default(PENDING)
  expiresAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  @@index([tenantId, studentId])
  @@index([gatewayOrderId])
}

model Payment {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNumber   String
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  payerParentId   String?
  payerParent     ParentProfile? @relation(fields: [payerParentId], references: [id], onDelete: SetNull)
  paymentIntentId String?        @unique
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  amount               Decimal       @db.Decimal(10, 2)
  paymentMode          PaymentMode   @default(ONLINE_GATEWAY)
  status               PaymentStatus @default(SUCCESS)
  paymentDate          DateTime      @default(now())
  transactionReference String?
  chequeNumber         String?
  bankName             String?
  gatewayPaymentId     String?
  journalEntryId       String?
  notes                String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]
  refunds     PaymentRefund[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, paymentDate])
}

model PaymentAllocation {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId       String
  payment         Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         FeeInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceItemId   String?
  invoiceItem     FeeInvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  allocatedAmount Decimal         @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@index([tenantId])
}

model PaymentRefund {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundNumber   String
  amount         Decimal       @db.Decimal(10, 2)
  reason         String        @db.Text
  refundDate     DateTime      @default(now())
  status         PaymentStatus @default(SUCCESS)
  journalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, refundNumber])
  @@index([paymentId])
  @@index([tenantId])
}

model PaymentWebhookEvent {
  id           String                 @id @default(cuid())
  tenantId     String?
  tenant       Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  provider     PaymentGatewayProvider
  eventId      String                 @unique
  eventType    String
  payloadJson  String                 @db.Text
  isProcessed  Boolean                @default(false)
  processedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([provider, eventId])
  @@index([isProcessed])
}

// ============================================================================
// PLANE 13: FINANCIAL GENERAL LEDGER (V2 WAVE 1)
// ============================================================================

model FiscalYear {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  yearLabel      String
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus  @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods FinancialPeriod[]

  @@unique([tenantId, yearLabel])
  @@index([tenantId, status])
}

model FinancialPeriod {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYearId String
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  periodNumber Int
  periodName   String
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus @default(OPEN)

  journalEntries JournalEntry[]

  @@unique([tenantId, fiscalYearId, periodNumber])
  @@index([fiscalYearId])
  @@index([tenantId, status])
}

model ChartOfAccount {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountCode    String
  accountName    String
  accountType    AccountType
  accountSubtype AccountSubtype
  description    String?
  isActive       Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerAccount LedgerAccount?
  journalLines  JournalLine[]

  @@unique([tenantId, accountCode])
  @@index([tenantId, accountType])
}

model LedgerAccount {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartOfAccountId String         @unique
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  openingBalance   Decimal        @default(0.0) @db.Decimal(12, 2)
  currentBalance   Decimal        @default(0.0) @db.Decimal(12, 2)
  currency         String         @default("INR")

  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model JournalEntry {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodId        String
  period          FinancialPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  entryNumber     String
  entryDate       DateTime
  postingDate     DateTime          @default(now())
  sourceType      JournalSourceType
  sourceId        String?
  referenceNumber String?
  narration       String            @db.Text
  status          JournalStatus     @default(POSTED)
  totalDebit      Decimal           @db.Decimal(12, 2)
  totalCredit     Decimal           @db.Decimal(12, 2)
  postedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, periodId])
  @@index([tenantId, entryDate])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lineNumber     Int
  debitAmount    Decimal        @default(0.0) @db.Decimal(12, 2)
  creditAmount   Decimal        @default(0.0) @db.Decimal(12, 2)
  narration      String?

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([tenantId])
}

// ============================================================================
// TRANSACTIONAL OUTBOX (V2 DOMAIN EVENTS)
// ============================================================================

model TenantOutboxEvent {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType     String
  eventVersion  String    @default("1.0")
  aggregateType String
  aggregateId   String
  payloadJson   String    @db.Text
  correlationId String
  occurredAt    DateTime  @default(now())
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  retryCount    Int       @default(0)
  lastError     String?

  @@index([tenantId, isPublished, occurredAt])
  @@index([aggregateType, aggregateId])
}

// ============================================================================
// PLANE 14: ADMISSIONS & ENQUIRY CRM (V2 WAVE 2)
// ============================================================================

model AdmissionSession {
  id             String                 @id @default(cuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String
  code           String
  startDate      DateTime
  endDate        DateTime
  status         AdmissionSessionStatus @default(OPEN)
  metadataJson   String?                @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries    AdmissionEnquiry[]
  applications AdmissionApplication[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([academicYearId])
}

model AdmissionSource {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  sourceType AdmissionSourceType @default(WALK_IN)
  isActive   Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries AdmissionEnquiry[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model AdmissionEnquiry {
  id                     String            @id @default(cuid())
  tenantId               String
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiryNumber          String
  prospectiveStudentName String
  prospectiveGender      Gender?
  prospectiveDob         DateTime?
  primaryContactName     String
  primaryContactPhone    String
  primaryContactEmail    String?
  primaryContactRelation String?
  address                String?           @db.Text
  interestedGradeId      String?
  interestedGrade        Grade?            @relation(fields: [interestedGradeId], references: [id], onDelete: SetNull)
  sourceId               String?
  source                 AdmissionSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sessionId              String?
  session                AdmissionSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status                 EnquiryStatus     @default(NEW)
  ownerUserId            String?
  owner                  User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  assignedAt             DateTime?
  notes                  String?           @db.Text
  lostReason             String?
  convertedAt            DateTime?
  convertedApplicantId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicants Applicant[]

  @@unique([tenantId, enquiryNumber])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, sessionId])
}

model Applicant {
  id                   String                 @id @default(cuid())
  tenantId             String
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicantNumber      String
  enquiryId            String?
  enquiry              AdmissionEnquiry?      @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  fullName             String
  gender               Gender
  dateOfBirth          DateTime
  bloodGroup           BloodGroup             @default(UNKNOWN)
  primaryPhone         String
  email                String?
  address              String?                @db.Text
  guardianName         String
  guardianPhone        String
  guardianEmail        String?
  guardianRelationship ParentRelationshipType @default(LEGAL_GUARDIAN)
  maskedNationalId     String?
  status               ApplicantStatus        @default(ACTIVE)
  duplicateMatchId     String?
  duplicateNotes       String?
  studentProfileId     String?
  studentProfile       StudentProfile?        @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications AdmissionApplication[]

  @@unique([tenantId, applicantNumber])
  @@index([tenantId, status])
  @@index([tenantId, dateOfBirth, fullName])
  @@index([tenantId, guardianPhone])
}

model AdmissionApplication {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationNumber  String
  sessionId          String
  session            AdmissionSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  applicantId        String
  applicant          Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  gradeId            String
  grade              Grade             @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  requestedClassId   String?
  requestedClass     Class?            @relation(fields: [requestedClassId], references: [id], onDelete: SetNull)
  status             ApplicationStatus @default(DRAFT)
  reviewerUserId     String?
  reviewer           User?             @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)
  submittedAt        DateTime?
  verifiedAt         DateTime?
  decisionAt         DateTime?
  notes              String?           @db.Text
  rejectionReason    String?
  cancellationReason String?
  feeInvoiceId       String?
  studentProfileId   String?
  studentProfile     StudentProfile?   @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     AdmissionApplicationDocument[]
  interviews    AdmissionInterview[]
  tests         AdmissionTest[]
  decisions     AdmissionDecision[]
  offers        AdmissionOffer[]
  confirmations AdmissionConfirmation[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, status])
  @@index([tenantId, sessionId])
  @@index([applicantId])
  @@index([tenantId, reviewerUserId])
}

model AdmissionApplicationDocument {
  id                  String                     @id @default(cuid())
  tenantId            String
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId       String
  application         AdmissionApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentReferenceId String
  documentReference   DocumentReference          @relation(fields: [documentReferenceId], references: [id], onDelete: Restrict)
  documentType        String
  verificationStatus  DocumentVerificationStatus @default(PENDING)
  verifiedByUserId    String?
  verifiedByUser      User?                      @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedAt          DateTime?
  rejectionReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, applicationId, documentReferenceId])
  @@index([applicationId])
  @@index([tenantId, verificationStatus])
}

model AdmissionInterview {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledDateTime DateTime
  interviewerUserId String?
  interviewer       User?                @relation(fields: [interviewerUserId], references: [id], onDelete: SetNull)
  mode              String               @default("IN_PERSON")
  location          String?
  status            InterviewStatus      @default(SCHEDULED)
  result            InterviewResult      @default(PENDING)
  notes             String?              @db.Text
  score             Decimal?             @db.Decimal(5, 2)
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledDateTime])
}

model AdmissionTest {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  testType          String
  scheduledDateTime DateTime
  maxScore          Decimal              @default(100.0) @db.Decimal(5, 2)
  passScore         Decimal              @default(40.0) @db.Decimal(5, 2)
  score             Decimal?             @db.Decimal(5, 2)
  evaluatorUserId   String?
  evaluator         User?                @relation(fields: [evaluatorUserId], references: [id], onDelete: SetNull)
  status            TestStatus           @default(SCHEDULED)
  result            TestResult           @default(PENDING)
  remarks           String?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([tenantId, status])
}

model AdmissionDecision {
  id              String                  @id @default(cuid())
  tenantId        String
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId   String
  application     AdmissionApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decision        ApplicationDecisionType
  reason          String?                 @db.Text
  decidedByUserId String
  decidedByUser   User                    @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  decidedAt       DateTime                @default(now())
  notes           String?                 @db.Text

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([tenantId, decision])
}

model AdmissionOffer {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offerNumber       String
  offeredGradeId    String
  offeredGrade      Grade                @relation(fields: [offeredGradeId], references: [id], onDelete: Restrict)
  offeredClassId    String?
  offeredClass      Class?               @relation(fields: [offeredClassId], references: [id], onDelete: SetNull)
  issuedDate        DateTime             @default(now())
  expiryDate        DateTime
  status            OfferStatus          @default(ISSUED)
  acceptedAt        DateTime?
  termsMetadataJson String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, offerNumber])
  @@index([applicationId])
  @@index([tenantId, status])
}

model AdmissionConfirmation {
  id                 String               @id @default(cuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId      String
  application        AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  confirmationNumber String
  confirmedAt        DateTime             @default(now())
  confirmedByUserId  String
  confirmedByUser    User                 @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  financialReference String?
  status             ConfirmationStatus   @default(CONFIRMED)
  notes              String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, confirmationNumber])
  @@index([applicationId])
  @@index([tenantId, status])
}

// ============================================================================
// PLANE 15: LIBRARY MANAGEMENT (V2 WAVE 3)
// ============================================================================

model Library {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  active      Boolean  @default(true)
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  policies LibraryPolicy[]
  books    LibraryBook[]
  copies   LibraryBookCopy[]
  members  LibraryMember[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model LibraryCategory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books LibraryBook[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model LibraryAuthor {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  bio       String?  @db.Text
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books LibraryBook[]

  @@index([tenantId, name])
}

model LibraryPublisher {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  contactEmail String?
  contactPhone String?
  address      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  books LibraryBook[]

  @@index([tenantId, name])
}

model LibraryBook {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  libraryId       String?
  library         Library?          @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  isbn            String?
  title           String
  subtitle        String?
  edition         String?
  language        String            @default("English")
  categoryId      String?
  category        LibraryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId        String?
  author          LibraryAuthor?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publisherId     String?
  publisher       LibraryPublisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  publicationYear Int?
  subject         String?
  metadata        String?           @db.Text
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  copies       LibraryBookCopy[]
  reservations LibraryReservation[]

  @@index([tenantId, title])
  @@index([tenantId, isbn])
  @@index([tenantId, categoryId])
  @@index([tenantId, authorId])
}

model LibraryBookCopy {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  libraryId       String?
  library         Library?       @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  bookId          String
  book            LibraryBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  accessionNumber String
  barcode         String?
  condition       String         @default("GOOD")
  status          BookCopyStatus @default(AVAILABLE)
  acquisitionDate DateTime       @default(now())
  location        String?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  loans LibraryLoan[]

  @@unique([tenantId, accessionNumber])
  @@index([bookId])
  @@index([tenantId, status])
  @@index([tenantId, barcode])
}

model LibraryMember {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  libraryId        String?
  library          Library?            @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  memberType       LibraryMemberType   @default(STUDENT)
  memberCode       String
  studentProfileId String?
  studentProfile   StudentProfile?     @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           LibraryMemberStatus @default(ACTIVE)
  joinedAt         DateTime            @default(now())
  expiresAt        DateTime?
  maxLoansOverride Int?
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  loans        LibraryLoan[]
  reservations LibraryReservation[]
  fines        LibraryFine[]

  @@unique([tenantId, memberCode])
  @@index([tenantId, studentProfileId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model LibraryLoan {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId         String
  member           LibraryMember   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookCopyId       String
  bookCopy         LibraryBookCopy @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  issuedAt         DateTime        @default(now())
  dueAt            DateTime
  returnedAt       DateTime?
  status           LoanStatus      @default(ISSUED)
  issuedByUserId   String
  issuedByUser     User            @relation("LibraryLoanIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  returnedByUserId String?
  returnedByUser   User?           @relation("LibraryLoanReceiver", fields: [returnedByUserId], references: [id], onDelete: SetNull)
  renewalCount     Int             @default(0)
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  fines LibraryFine[]

  @@index([memberId])
  @@index([bookCopyId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
}

model LibraryReservation {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String
  member      LibraryMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookId      String
  book        LibraryBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  requestedAt DateTime          @default(now())
  status      ReservationStatus @default(PENDING)
  fulfilledAt DateTime?
  expiryAt    DateTime
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([memberId])
  @@index([bookId])
  @@index([tenantId, status])
}

model LibraryFine {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId           String
  member             LibraryMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  loanId             String?
  loan               LibraryLoan?  @relation(fields: [loanId], references: [id], onDelete: SetNull)
  amount             Decimal       @db.Decimal(10, 2)
  reason             String
  status             FineStatus    @default(UNPAID)
  assessedAt         DateTime      @default(now())
  waivedAt           DateTime?
  waivedByUserId     String?
  waivedByUser       User?         @relation("LibraryFineWaiver", fields: [waivedByUserId], references: [id], onDelete: SetNull)
  waiveReason        String?
  feeAssignmentId    String?
  feePaymentId       String?
  financialReference String?
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([memberId])
  @@index([loanId])
  @@index([tenantId, status])
}

model LibraryPolicy {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  libraryId             String?
  library               Library? @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  name                  String
  defaultLoanPeriodDays Int      @default(14)
  maxActiveLoans        Int      @default(3)
  renewalLimit          Int      @default(2)
  finePerDayCents       Decimal  @default(5.00) @db.Decimal(10, 2)
  gracePeriodDays       Int      @default(0)
  reservationExpiryDays Int      @default(3)
  isDefault             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId, isDefault])
}

// ============================================================================
// PLANE 16: TRANSPORT MANAGEMENT (V2 WAVE 3)
// ============================================================================

model TransportFacility {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  active    Boolean  @default(true)
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model TransportRoute {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeCode     String
  name          String
  direction     RouteDirection @default(BOTH)
  startPoint    String?
  endPoint      String?
  operatingDays String         @default("MON,TUE,WED,THU,FRI")
  startTime     String?
  endTime       String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stops              TransportStop[]
  assignments        TransportRouteAssignment[]
  studentAssignments StudentTransportAssignment[]
  incidents          TransportIncident[]

  @@unique([tenantId, routeCode])
  @@index([tenantId, active])
}

model TransportStop {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeId    String
  route      TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName   String
  sequence   Int
  latitude   Decimal?       @db.Decimal(10, 7)
  longitude  Decimal?       @db.Decimal(10, 7)
  pickupTime String?
  dropTime   String?
  landmark   String?
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  pickupAssignments StudentTransportAssignment[] @relation("PickupStop")
  dropAssignments   StudentTransportAssignment[] @relation("DropStop")

  @@unique([routeId, sequence])
  @@index([tenantId, active])
}

model TransportVehicle {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationNumber String
  vehicleType        VehicleType   @default(BUS)
  capacity           Int           @default(40)
  status             VehicleStatus @default(ACTIVE)
  make               String?
  model              String?
  year               Int?
  insurancePolicy    String?
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  permitExpiry       DateTime?
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  routeAssignments TransportRouteAssignment[]
  incidents        TransportIncident[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, status])
}

model TransportDriver {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  phone         String
  licenseNumber String
  licenseType   String?
  licenseExpiry DateTime?
  status        DriverStatus @default(ACTIVE)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  routeAssignments TransportRouteAssignment[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId, status])
  @@index([tenantId, userId])
}

model TransportAttendant {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  status    AttendantStatus @default(ACTIVE)
  notes     String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  routeAssignments TransportRouteAssignment[]

  @@index([tenantId, status])
  @@index([tenantId, userId])
}

model TransportRouteAssignment {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeId       String
  route         TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId     String
  vehicle       TransportVehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId      String?
  driver        TransportDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  attendantId   String?
  attendant     TransportAttendant? @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  effectiveFrom DateTime            @default(now())
  effectiveTo   DateTime?
  shift         RouteShift          @default(BOTH)
  active        Boolean             @default(true)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([routeId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tenantId, active])
}

model StudentTransportAssignment {
  id              String                    @id @default(cuid())
  tenantId        String
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  routeId         String
  route           TransportRoute            @relation(fields: [routeId], references: [id], onDelete: Restrict)
  pickupStopId    String
  pickupStop      TransportStop             @relation("PickupStop", fields: [pickupStopId], references: [id], onDelete: Restrict)
  dropStopId      String
  dropStop        TransportStop             @relation("DropStop", fields: [dropStopId], references: [id], onDelete: Restrict)
  academicYearId  String
  academicYear    AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  effectiveFrom   DateTime                  @default(now())
  effectiveTo     DateTime?
  status          TransportAssignmentStatus @default(ACTIVE)
  feeStructureId  String?
  feeAssignmentId String?
  passNumber      String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  passes TransportPass[]

  @@index([routeId])
  @@index([pickupStopId])
  @@index([dropStopId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, academicYearId])
}

model TransportPass {
  id              String                     @id @default(cuid())
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId    String
  assignment      StudentTransportAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  passNumber      String
  qrCodeReference String?
  validFrom       DateTime                   @default(now())
  validTo         DateTime
  status          TransportPassStatus        @default(ACTIVE)
  issuedAt        DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([tenantId, passNumber])
  @@index([assignmentId])
  @@index([tenantId, status])
}

model TransportIncident {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeId          String?
  route            TransportRoute?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicleId        String?
  vehicle          TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  incidentDate     DateTime          @default(now())
  incidentTime     String?
  reporterUserId   String?
  reporterUser     User?             @relation("TransportIncidentReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  severity         IncidentSeverity  @default(LOW)
  description      String            @db.Text
  status           IncidentStatus    @default(OPEN)
  resolutionNotes  String?           @db.Text
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?             @relation("TransportIncidentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([routeId])
  @@index([vehicleId])
  @@index([tenantId, status])
  @@index([tenantId, severity])
}

// ============================================================================
// PLANE 17: INVENTORY MANAGEMENT (V2 WAVE 4)
// ============================================================================

model InventoryCategory {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?             @db.Text
  parentId    String?
  parent      InventoryCategory?  @relation("InventoryCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    InventoryCategory[] @relation("InventoryCategoryHierarchy")
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model InventoryUnit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  symbol    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model InventoryVendor {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorCode   String
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?  @db.Text
  taxId        String?
  paymentTerms String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders InventoryPurchaseOrder[]
  receipts       InventoryReceipt[]
  reorderRules   InventoryReorderRule[]
  assets         Asset[]

  @@unique([tenantId, vendorCode])
  @@index([tenantId, active])
}

model InventoryWarehouse {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  name           String
  managerStaffId String?
  managerStaff   StaffProfile? @relation(fields: [managerStaffId], references: [id], onDelete: SetNull)
  address        String?       @db.Text
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  locations    InventoryLocation[]
  stocks       InventoryStock[]
  receipts     InventoryReceipt[]
  issues       InventoryIssue[]
  transfersOut InventoryTransfer[]    @relation("SourceWarehouse")
  transfersIn  InventoryTransfer[]    @relation("DestinationWarehouse")
  adjustments  InventoryAdjustment[]
  reservations InventoryReservation[]
  reorderRules InventoryReorderRule[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model InventoryLocation {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  aisle       String?
  rack        String?
  shelf       String?
  bin         String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  stocks InventoryStock[]

  @@unique([warehouseId, code])
  @@index([tenantId, active])
}

model InventoryItem {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku              String
  internalCode     String?
  barcode          String?
  name             String
  description      String?            @db.Text
  categoryId       String?
  category         InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitId           String
  unit             InventoryUnit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reorderThreshold Decimal            @default(10) @db.Decimal(12, 2)
  reorderQuantity  Decimal            @default(50) @db.Decimal(12, 2)
  minStock         Decimal            @default(0) @db.Decimal(12, 2)
  maxStock         Decimal?           @db.Decimal(12, 2)
  active           Boolean            @default(true)
  trackLot         Boolean            @default(false)
  trackExpiry      Boolean            @default(false)
  valuationMethod  ValuationMethod    @default(FIFO)
  unitCost         Decimal            @default(0) @db.Decimal(12, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  stocks               InventoryStock[]
  lots                 InventoryStockLot[]
  movements            InventoryStockMovement[]
  purchaseRequestItems InventoryPurchaseRequestItem[]
  purchaseOrderItems   InventoryPurchaseOrderItem[]
  receiptItems         InventoryReceiptItem[]
  issueItems           InventoryIssueItem[]
  transferItems        InventoryTransferItem[]
  adjustmentItems      InventoryAdjustmentItem[]
  reservations         InventoryReservation[]
  reorderRules         InventoryReorderRule[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, active])
  @@index([tenantId, categoryId])
}

model InventoryStock {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String?
  location    InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  onHand      Decimal            @default(0) @db.Decimal(12, 2)
  reserved    Decimal            @default(0) @db.Decimal(12, 2)
  available   Decimal            @default(0) @db.Decimal(12, 2)
  damaged     Decimal            @default(0) @db.Decimal(12, 2)
  unitCost    Decimal            @default(0) @db.Decimal(12, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId, itemId])
  @@index([tenantId, warehouseId])
  @@index([warehouseId, itemId])
}

model InventoryStockLot {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotNumber         String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  quantity          Decimal       @default(0) @db.Decimal(12, 2)
  unitCost          Decimal       @default(0) @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, itemId, lotNumber])
  @@index([tenantId, expiryDate])
}

model InventoryStockMovement {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId                String
  item                  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceLocationId      String?
  destinationLocationId String?
