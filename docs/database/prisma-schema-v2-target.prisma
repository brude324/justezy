// ============================================================================
// Target Physical Prisma Schema — SchoolyardSMS Multi-Tenant Education SaaS
// File: docs/database/prisma-schema-v2-target.prisma
// Phase: V2 Target Architecture Design (DESIGN ONLY - DO NOT RUN DIRECTLY ON LIVE DB)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (V1 Baseline + V2 Extensions)
// ============================================================================

