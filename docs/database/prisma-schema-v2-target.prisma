  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationNumber String
  vehicleType        VehicleType   @default(BUS)
  capacity           Int           @default(40)
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  pucExpiry          DateTime?
  status             VehicleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes              TransportRoute[]
  maintenanceRecords VehicleMaintenanceRecord[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, status])
}

model TransportDriver {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfileId String?
  staffProfile   StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  fullName       String
  phone          String
  licenseNumber  String
  licenseExpiry  DateTime
  status         String        @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes TransportRoute[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId, status])
}

model TransportRoute {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeName   String
  routeCode   String
  vehicleId   String?
  vehicle     TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId    String?
  driver      TransportDriver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  monthlyFee  Decimal           @default(0.0) @db.Decimal(10, 2)
  status      String            @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops       RouteStop[]
