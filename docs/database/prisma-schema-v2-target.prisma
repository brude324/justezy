  bookId          String
  book            Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  branchId        String
  branch          LibraryBranch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accessionNumber String
  barcode         String?
  status          BookCopyStatus  @default(AVAILABLE)
  shelfLocation   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrowRecords BookBorrowRecord[]

  @@unique([tenantId, accessionNumber])
  @@index([bookId])
  @@index([tenantId, status])
}

model LibraryMembership {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipNumber String
  memberType       String
  studentId        String?
  student          StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staffId          String?
  staff            StaffProfile?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  maxBorrowLimit   Int             @default(3)
  isActive         Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrowRecords BookBorrowRecord[]

  @@unique([tenantId, membershipNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, staffId])
}

model BookBorrowRecord {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String
  membership   LibraryMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bookCopyId   String
  bookCopy     BookCopy          @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  issueDate    DateTime          @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  status       BorrowStatus      @default(ACTIVE)
  issuedByUserId String

  fines LibraryFine[]

  @@index([membershipId])
  @@index([bookCopyId])
  @@index([tenantId, status])
}

model LibraryFine {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  borrowRecordId String
  borrowRecord   BookBorrowRecord @relation(fields: [borrowRecordId], references: [id], onDelete: Cascade)
  amount         Decimal          @db.Decimal(10, 2)
  fineDate       DateTime         @default(now())
  reason         String
  status         FineStatus       @default(PENDING)
  feeInvoiceId   String?
  feeInvoice     FeeInvoice?      @relation(fields: [feeInvoiceId], references: [id], onDelete: SetNull)
  collectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([borrowRecordId])
  @@index([tenantId, status])
}

