// PLANE 14: ADMISSIONS & ENQUIRY CRM (V2)
// ============================================================================

model AdmissionSession {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  title          String
  startDate      DateTime
  endDate        DateTime
  applicationFee Decimal      @default(0.0) @db.Decimal(10, 2)
  status         String       @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries    AdmissionEnquiry[]
  applications AdmissionApplication[]

  @@unique([tenantId, academicYearId, title])
  @@index([tenantId, status])
}

model AdmissionEnquiry {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admissionSessionId String
  admissionSession   AdmissionSession @relation(fields: [admissionSessionId], references: [id], onDelete: Cascade)
  enquiryNumber      String
  studentName        String
  gradeLevel         Int
  parentName         String
  parentPhone        String
  parentEmail        String?
  status             EnquiryStatus    @default(NEW)
  followUpDate       DateTime?
  notes              String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications AdmissionApplication[]

  @@unique([tenantId, enquiryNumber])
  @@index([tenantId, parentPhone])
  @@index([tenantId, status])
}

model AdmissionApplication {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admissionSessionId  String
  admissionSession    AdmissionSession   @relation(fields: [admissionSessionId], references: [id], onDelete: Restrict)
  applicationNumber   String
  enquiryId           String?
  enquiry             AdmissionEnquiry?  @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  applicantFirstName  String
  applicantLastName   String
  gender              Gender
  dateOfBirth         DateTime
  appliedGradeLevel   Int
  parentName          String
  parentPhone         String
  parentEmail         String
  address             String?            @db.Text
  status              ApplicationStatus  @default(SUBMITTED)
  applicationFeePaid  Boolean            @default(false)

  convertedStudentId  String?            @unique
  convertedStudent    StudentProfile?    @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents  AdmissionDocument[]
  interviews AdmissionInterview[]
  offers     AdmissionOffer[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, status])
  @@index([tenantId, parentPhone])
}

model AdmissionDocument {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId       String
  application         AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType        String
  documentReferenceId String
  documentReference   DocumentReference @relation(fields: [documentReferenceId], references: [id], onDelete: Restrict)
  isVerified          Boolean           @default(false)
  verifiedByUserId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([tenantId])
}

model AdmissionInterview {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime
  interviewerUserId String?
  resultNotes       String?              @db.Text
  rating            Int?
  status            String               @default("SCHEDULED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([tenantId])
}

model AdmissionOffer {
  id                  String                @id @default(cuid())
  tenantId            String
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicationId       String
  application         AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offerCode           String
  decisionType        AdmissionDecisionType @default(ACCEPTED)
  offerDate           DateTime              @default(now())
  expiryDate          DateTime
  admissionFeeRequired Decimal              @db.Decimal(10, 2)
  admissionFeePaid    Boolean               @default(false)
  isAccepted          Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, offerCode])
  @@index([applicationId])
}

