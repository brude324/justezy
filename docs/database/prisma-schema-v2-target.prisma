  maintenanceDate DateTime
  odometerReading Int?
  cost            Decimal          @db.Decimal(10, 2)
  description     String           @db.Text
  vendorName      String?
  journalEntryId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([tenantId, maintenanceDate])
}

// ============================================================================
// PLANE 17: INVENTORY & ASSET MANAGEMENT (V2)
// ============================================================================

model InventoryCategory {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  code     String
  itemType InventoryItemType @default(CONSUMABLE)

  items InventoryItem[]

  @@unique([tenantId, code])
}

model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorName    String
  contactPerson String?
  phone         String
  email         String?
  taxNumber     String?
  address       String?  @db.Text
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches StockBatch[]

  @@unique([tenantId, vendorName])
  @@index([tenantId, isActive])
}

model InventoryItem {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId          String
  category            InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  itemCode            String
  name                String
  unitOfMeasure       String
  itemType            InventoryItemType @default(CONSUMABLE)
  reorderThreshold    Int               @default(10)
  currentStockQuantity Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches   StockBatch[]
  movements StockMovement[]
  assets    AssetRegister[]

  @@unique([tenantId, itemCode])
  @@index([tenantId, categoryId])
}

model StockBatch {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendorId          String?
  vendor            Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  batchNumber       String?
  unitPurchaseCost  Decimal       @db.Decimal(10, 2)
  quantityReceived  Int
  quantityRemaining Int
  purchaseDate      DateTime      @default(now())
  expiryDate        DateTime?

  movements StockMovement[]

  @@index([itemId])
  @@index([tenantId])
}

model StockMovement {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId          String?
  batch            StockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  movementType     StockMovementType
  quantity         Int
  unitCost         Decimal           @db.Decimal(10, 2)
  issuedToStaffId  String?
  sourceId         String?
  movementDate     DateTime          @default(now())
  remarks          String?           @db.Text

  @@index([itemId])
  @@index([tenantId, movementDate])
}

model AssetRegister {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  assetTagNumber   String
  serialNumber     String?
  purchaseCost     Decimal        @db.Decimal(10, 2)
  purchaseDate     DateTime
  condition        AssetCondition @default(NEW)
  location         String?

  assignments AssetAssignment[]

  @@unique([tenantId, assetTagNumber])
  @@index([itemId])
  @@index([tenantId, condition])
}

model AssetAssignment {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId           String
  asset             AssetRegister @relation(fields: [assetId], references: [id], onDelete: Cascade)
  staffId           String
  staff             StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  assignedDate      DateTime      @default(now())
  returnDate        DateTime?
  conditionAtReturn AssetCondition?

  @@index([assetId])
  @@index([staffId])
  @@index([tenantId])
}

// ============================================================================
// PLANE 18: HR & PAYROLL (V2)
// ============================================================================

model StaffLeavePolicy {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveType           LeaveType
  annualQuotaDays     Int       @default(12)
  carryForwardMaxDays Int       @default(0)

  @@unique([tenantId, leaveType])
}

model StaffLeaveRequest {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId          String
  staff            StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType        LeaveType
  startDate        DateTime
  endDate          DateTime
  totalDays        Int
  reason           String       @db.Text
  status           LeaveStatus  @default(PENDING)
  approvedByUserId String?
  actionDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([tenantId, status])
}

model StaffAttendanceRecord {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date           DateTime
  status         StaffAttendanceStatus @default(PRESENT)
  checkInTime    String?
  checkOutTime   String?
  remarks        String?

  @@unique([tenantId, staffId, date])
  @@index([tenantId, date, status])
}

model SalaryStructure {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false)

  components  SalaryComponent[]
  assignments StaffSalaryAssignment[]

  @@unique([tenantId, name])
}

model SalaryComponent {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structureId        String
  structure          SalaryStructure     @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentName      String
  componentCode      String
  componentType      SalaryComponentType
  isTaxable          Boolean             @default(true)
  calculationFormula String?

  @@unique([structureId, componentCode])
  @@index([tenantId])
}

model StaffSalaryAssignment {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId            String
  staff              StaffProfile    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  structureId        String
  structure          SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)
  monthlyGrossSalary Decimal         @db.Decimal(10, 2)
  effectiveFromDate  DateTime
  status             String          @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([tenantId, status])
}

model PayrollRun {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  payrollDate      DateTime      @default(now())
  totalGross       Decimal       @db.Decimal(12, 2)
  totalDeductions  Decimal       @db.Decimal(12, 2)
  totalNetPayable  Decimal       @db.Decimal(12, 2)
  status           PayrollStatus @default(DRAFT)
  approvedByUserId String?
  journalEntryId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@unique([tenantId, month, year])
  @@index([tenantId, status])
}

model Payslip {
  id                     String       @id @default(cuid())
  tenantId               String
  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId           String
  payrollRun             PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staffId                String
  staff                  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)
  grossEarnings          Decimal      @db.Decimal(10, 2)
  totalDeductions        Decimal      @db.Decimal(10, 2)
  netPayable             Decimal      @db.Decimal(10, 2)
  paymentMode            PaymentMode  @default(BANK_TRANSFER)
  disbursementReference  String?
  disbursedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayslipItem[]

  @@unique([payrollRunId, staffId])
  @@index([staffId])
  @@index([tenantId])
}

model PayslipItem {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslipId     String
  payslip       Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentName String
  componentType SalaryComponentType
  amount        Decimal             @db.Decimal(10, 2)

  @@index([payslipId])
  @@index([tenantId])
}
