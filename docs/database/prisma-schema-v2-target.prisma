  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lineNumber     Int
  debitAmount    Decimal        @default(0.0) @db.Decimal(12, 2)
  creditAmount   Decimal        @default(0.0) @db.Decimal(12, 2)
  narration      String?

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([tenantId])
}

