  accountCode    String
  accountName    String
  accountType    AccountType
  accountSubtype AccountSubtype
  description    String?
  isActive       Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerAccount LedgerAccount?
  journalLines  JournalLine[]

  @@unique([tenantId, accountCode])
  @@index([tenantId, accountType])
}

model LedgerAccount {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartOfAccountId String         @unique
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Cascade)
  openingBalance   Decimal        @default(0.0) @db.Decimal(12, 2)
  currentBalance   Decimal        @default(0.0) @db.Decimal(12, 2)
  currency         String         @default("INR")

  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model JournalEntry {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodId        String
  period          FinancialPeriod   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  entryNumber     String
  entryDate       DateTime
  postingDate     DateTime          @default(now())
  sourceType      JournalSourceType
  sourceId        String?
