# ==============================================================================
# SchoolyardSMS Environment Variables Reference Template
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT:
#   cp .env.example .env.local
#
# SECURITY RULES:
# 1. NEVER commit real secrets or credentials to Git.
# 2. Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# 3. Server-only secrets MUST NEVER use the NEXT_PUBLIC_ prefix.
# 4. Values in this example file are strictly non-sensitive placeholders.
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (Server-Only Secret)
# ==============================================================================
# PostgreSQL connection string used by Prisma.
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/schoolyard_dev
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolyard_dev?schema=public"

# ==============================================================================
# 2. CLERK AUTHENTICATION & IDENTITY (Dual Server Secret / Public Client)
# ==============================================================================
# Public Publishable Key (Client-Safe: used by @clerk/nextjs browser SDK)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key_for_development"

# Clerk Secret Key (Server-Only Secret: used for server-side auth and Clerk API calls)
CLERK_SECRET_KEY="sk_test_placeholder_secret_key_for_development"

# Clerk Route Redirects (Client-Safe: standard authentication paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ==============================================================================
# 3. MEDIA STORAGE (Client-Safe)
# ==============================================================================
# Cloudinary cloud name for student/teacher photo uploads via CldUploadWidget
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo"

# ==============================================================================
# 4. LOCAL DOCKER / POSTGRESQL (Optional - matches docker-compose.yml)
# ==============================================================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="schoolyard_dev"
